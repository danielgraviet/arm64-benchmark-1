# Copy to .env on the DUT. Never commit .env.

# Localhost cell (on-node client). Do not point these at a laptop tunnel.
RLP_API_URL=http://127.0.0.1:8088
REDSWITCHES_RLP_API_URL=http://127.0.0.1:8088
REDSWITCHES_RLP_TOOLBOX_URL=http://127.0.0.1:9000/toolbox

# Required. Paste the cell API key by hand.
RLP_API_KEY=
# REDSWITCHES_RLP_API_KEY=

RLP_HTTP_MAX_CONNECTIONS=4096
