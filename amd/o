#!/usr/bin/env bash
# Operator CLI for AMD vendor EPYC 9996 (empty Ubuntu → RLP → results).
# Separate from nvidia/o (9755) and phoenix-e6/o (9J45).
#
#   export GH_TOKEN=…   # or source .env.amd / .env.nvidia with GH_TOKEN
#   ./o start && ./o hw && ./o pin && ./o test
#   ./o clean && ./o 1k
set -euo pipefail

AMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${AMD_DIR}/.." && pwd)"
SCRIPTS="${AMD_DIR}/scripts"
cd "${ROOT}"
export PATH="${HOME}/.local/bin:/usr/local/bin:${PATH}"
export TARGET=epyc9996
export OUT_DIR="${OUT_DIR:-daniel-focus-here/zen5-9996-jsonl}"

cmd="${1:-help}"
shift || true

load_env_if_present() {
  if [[ -z "${GH_TOKEN:-}" && -f "${ROOT}/.env.amd" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${ROOT}/.env.amd"
    set +a
  fi
  if [[ -z "${GH_TOKEN:-}" && -f "${AMD_DIR}/.env.amd" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${AMD_DIR}/.env.amd"
    set +a
  fi
  if [[ -z "${GH_TOKEN:-}" && -f "${ROOT}/.env.nvidia" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${ROOT}/.env.nvidia"
    set +a
  fi
}

require_pin() {
  echo "[amd/o] ensure socket-0 pin before timed run" >&2
  bash "${SCRIPTS}/pin_socket.sh" 0
}

tmux_run() {
  local session="$1"
  local script="$2"
  if tmux has-session -t "${session}" 2>/dev/null; then
    echo "tmux session '${session}' already exists. Attach: tmux attach -t ${session}" >&2
    exit 1
  fi
  tmux new-session -d -s "${session}" "bash ${script}"
  echo "started tmux session '${session}'"
  echo "  attach: tmux attach -t ${session}"
  echo "  status: ${AMD_DIR}/o status"
}

case "${cmd}" in
  start|boot|bootstrap)
    load_env_if_present
    if [[ -z "${GH_TOKEN:-}" ]]; then
      echo "need GH_TOKEN for clone (export GH_TOKEN=… or put it in amd/.env.amd)." >&2
      echo "Or: SKIP_CLONE=1 with ~/rlp already present." >&2
      if [[ "${SKIP_CLONE:-0}" != "1" ]]; then
        exit 1
      fi
    fi
    if [[ -x /usr/local/bin/rlp-api && -z "${SKIP_BUILD:-}" ]]; then
      export SKIP_BUILD=1
      echo "SKIP_BUILD=1 (rlp-api already installed)"
    fi
    exec bash "${SCRIPTS}/bootstrap.sh" "$@"
    ;;
  k|kernel|guest)
    exec bash "${SCRIPTS}/build_guest.sh" "$@"
    ;;
  pin)
    if [[ "${1:-}" == "undo" ]]; then
      exec bash "${SCRIPTS}/pin_socket.sh" undo
    fi
    exec bash "${SCRIPTS}/pin_socket.sh" "${1:-0}"
    ;;
  test)
    require_pin
    bash "${SCRIPTS}/check_parity.sh" --strict
    exec bash "${SCRIPTS}/smoke.sh" "$@"
    ;;
  check|parity)
    exec bash "${SCRIPTS}/check_parity.sh" "$@"
    ;;
  clean)
    exec bash "${SCRIPTS}/clean_cell.sh" "$@"
    ;;
  1k|1|c1k)
    require_pin
    tmux_run zen5-1k "${SCRIPTS}/run_1k.sh"
    ;;
  2k|2|c2k)
    require_pin
    tmux_run zen5-2k "${SCRIPTS}/run_2k.sh"
    ;;
  full-ladder|ladder|dense|d)
    require_pin
    tmux_run zen5-dense2k "${SCRIPTS}/run_full_ladder.sh"
    ;;
  hw|hardware|inventory)
    exec bash "${SCRIPTS}/capture_host_hw.sh" "$@"
    ;;
  status|t)
    exec bash "${ROOT}/scripts/host/status.sh" "$@"
    ;;
  smoke)
    require_pin
    exec bash "${SCRIPTS}/smoke.sh" "$@"
    ;;
  help|-h|--help|h|"")
    cat <<'EOF'
amd/o — AMD vendor EPYC 9996 (empty Ubuntu → results)

  ./o start         boot cell + harness + eng SDK + create tune
  ./o k             build amd64 guest Image/vmlinux + initdisk
  ./o hw            capture chip/server inventory (JSON+MD)
  ./o pin [0|1|undo]  pin rlp.slice to one socket (default 0)
  ./o check         Vera-closeness parity gate (epyc9996)
  ./o test          pin + parity --strict + one-sandbox smoke
  ./o clean         drain sandboxes; fail if FC orphans remain
  ./o 1k            create-ready 1000 (tmux zen5-1k)
  ./o 2k            create-ready 2000 (tmux zen5-2k)
  ./o full-ladder   dense agent ladder 44→2000 n=45 (tmux zen5-dense2k)
  ./o status        cell / FC / disk snapshot

Mac break-glass (password in amd/.env.amd):
  ./ssh / ./scp / ./install_pubkey.sh

Typical sequence (see RUNBOOK.md + tickets/amd-codex-host.md):
  export GH_TOKEN=…
  ./o start && ./o hw && ./o pin && ./o test
  ./o clean && ./o 1k
EOF
    ;;
  *)
    echo "unknown: ${cmd}  (./o help)" >&2
    exit 2
    ;;
esac
