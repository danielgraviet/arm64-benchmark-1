@@ -2660,6 +2669,31 @@ func coldLauncherWrap(cmd *exec.Cmd, spec BootSpec, fcnsBin string, ksm bool, cg
 func fcBool(b bool) *bool    { return &b }
 func fcInt64(i int64) *int64 { return &i }
 
+// fcSmt returns the machine-config `smt` flag for a boot of `vcpus` vCPUs, or
+// nil to OMIT the field entirely (PLAN-ARM64-SMT.md).
+//
+// Omitting is the load-bearing default. models.MachineConfiguration.Smt is
+// `*bool` + `omitempty`, so a nil here keeps `smt` out of the PUT /machine-config
+// body — which is the only reason this runner has ever worked on aarch64:
+// upstream Firecracker rejects the field on aarch64 with
+// MachineConfigError::SmtNotSupported, so even an explicit `smt: false` would
+// fail every boot on a stock arm64 runner. Never "set it for determinism".
+//
+// Two conditions must BOTH hold before we send it:
+//   - m.smt (RLP_FC_SMT=1) — the operator asserts an SMT-capable FC is installed
+//     (the v1.16.1-rlpsmt1 fork on arm64; x86 FC supports smt natively).
+//   - an EVEN vcpu count > 1 — every Firecracker rejects smt=true with an odd
+//     vcpu_count (MachineConfigError::InvalidVcpuCount), and the fork pairs
+//     vCPUs (2i, 2i+1) as the two threads of core i, so an odd count has no
+//     valid pairing. Odd/1-vCPU shapes silently boot without SMT rather than
+//     failing the create; sizing, capacity and billing are untouched.
+func (m *Manager) fcSmt(vcpus int) *bool {
+	if !m.smt || vcpus <= 1 || vcpus%2 != 0 {
+		return nil
+	}
+	return fcBool(true)
+}
