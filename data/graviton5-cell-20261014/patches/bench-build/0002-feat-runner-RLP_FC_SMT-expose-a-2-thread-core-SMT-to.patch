 	// Function-ready snapshots get a distinct template (paused after handler
 	// init). ExtraKey is omitempty, so ordinary sandbox keys are byte-identical
@@ -984,6 +998,10 @@ func (m *Manager) buildTemplateInto(ctx context.Context, spec BootSpec, key Temp
 		MachineCfg: models.MachineConfiguration{
 			VcpuCount:  fcInt64(int64(spec.Vcpus)),
 			MemSizeMib: fcInt64(int64(spec.MemMiB)),
+			// SMT is frozen into the snapshot's machine config, so it must be
+			// set at BUILD time; TemplateKey.SMT keeps SMT and non-SMT
+			// templates in separate dirs.
+			Smt: m.fcSmt(spec.Vcpus),
 		},
 		NetworkInterfaces: []fc.NetworkInterface{{
 			StaticConfiguration: &fc.StaticNetworkConfiguration{
