@@ -1197,6 +1205,7 @@ func (m *Manager) coldBoot(ctx context.Context, spec BootSpec, extraDrives func(
 		MachineCfg: models.MachineConfiguration{
 			VcpuCount:  fcInt64(int64(spec.Vcpus)),
 			MemSizeMib: fcInt64(int64(spec.MemMiB)),
