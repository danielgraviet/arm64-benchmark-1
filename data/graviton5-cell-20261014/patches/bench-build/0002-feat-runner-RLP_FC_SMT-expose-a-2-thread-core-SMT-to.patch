diff --git a/runner/internal/vm/smt_test.go b/runner/internal/vm/smt_test.go
new file mode 100644
index 000000000..f6ff18aec
--- /dev/null
+++ b/runner/internal/vm/smt_test.go
@@ -0,0 +1,135 @@
+package vm
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func mustMarshal(t *testing.T, v any) string {
+	t.Helper()
+	b, err := json.Marshal(v)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+// ---------------- aarch64 SMT (PLAN-ARM64-SMT.md) ----------------
+
+// TestFcSmtOmittedUnlessEnabledAndEven pins the two rules that make the `smt`
+// machine-config field safe to emit at all.
+//
+// Rule 1 — omitted by default. models.MachineConfiguration.Smt is `*bool` +
+// `omitempty`, so nil keeps `smt` out of the PUT /machine-config body. Upstream
+// Firecracker rejects the field on aarch64 with SmtNotSupported, so an explicit
+// `false` is NOT equivalent to omitting it: it would fail every boot on a stock
+// arm64 runner. Before this feature the field was left unset only by accident;
+// this test makes it deliberate.
+//
+// Rule 2 — even vCPU counts only. Every Firecracker rejects smt=true with an odd
+// vcpu_count (InvalidVcpuCount), and the fork pairs vCPUs (2i, 2i+1) as the two
+// threads of core i, so an odd count has no valid pairing.
+func TestFcSmtOmittedUnlessEnabledAndEven(t *testing.T) {
+	cases := []struct {
+		name    string
+		smtFlag bool
+		vcpus   int
+		want    bool // true => expect smt=true sent; false => expect field omitted
+	}{
+		{"disabled/even", false, 2, false},
+		{"disabled/odd", false, 3, false},
+		{"disabled/single", false, 1, false},
+		{"enabled/single", true, 1, false},
+		{"enabled/odd", true, 3, false},
+		{"enabled/odd-large", true, 15, false},
+		{"enabled/zero", true, 0, false},
+		{"enabled/negative", true, -2, false},
+		{"enabled/even", true, 2, true},
+		{"enabled/even-large", true, 16, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			m := &Manager{smt: tc.smtFlag}
+			got := m.fcSmt(tc.vcpus)
+			if !tc.want {
+				if got != nil {
+					t.Fatalf("fcSmt(smt=%v, vcpus=%d) = %v, want nil (field must be OMITTED — "+
+						"an explicit smt=false is rejected by upstream FC on aarch64)",
+						tc.smtFlag, tc.vcpus, *got)
+				}
+				return
+			}
+			if got == nil {
+				t.Fatalf("fcSmt(smt=%v, vcpus=%d) = nil, want smt=true", tc.smtFlag, tc.vcpus)
+			}
+			if !*got {
+				t.Fatalf("fcSmt(smt=%v, vcpus=%d) = false, want true — we never send an "+
+					"explicit false", tc.smtFlag, tc.vcpus)
+			}
+		})
+	}
+}
+
+// TestTemplateKeySMTOmitEmptyPreservesLegacyHash guards the content-address of
+// every template built before SMT existed. TemplateKey.Hash() is both the
+// on-disk directory name and the chunk-CAS address, so a non-omitempty field
+// would silently orphan the entire existing template cache.
+func TestTemplateKeySMTOmitEmptyPreservesLegacyHash(t *testing.T) {
+	base := TemplateKey{
+		ManifestName: "alpine", ManifestDigest: "sha256:abc", DaemonVersion: "v1",
+		KernelPath: "/k", FCVersion: "v1.16.1", CPUMarker: "deadbeef",
+		Vcpus: 2, MemMiB: 512, ScratchMiB: 512,
+	}
+	withSMT := base
+	withSMT.SMT = true
+
+	if base.Hash() == withSMT.Hash() {
+		t.Fatal("SMT=true must produce a DIFFERENT template hash — an SMT guest and a " +
+			"non-SMT guest cannot share a frozen machine config")
+	}
+
+	// The zero value must serialize away entirely, leaving legacy hashes intact.
+	if strings.Contains(mustMarshal(t, base), "smt") {
+		t.Error("TemplateKey{SMT:false} must not serialize an `smt` field — omitempty is " +
+			"what keeps pre-SMT template hashes (dir names + CAS addresses) stable")
+	}
+	if !strings.Contains(mustMarshal(t, withSMT), "smt") {
+		t.Error("TemplateKey{SMT:true} must serialize an `smt` field")
+	}
+}
+
+// TestFirecrackerConfigsUseFcSmtHelper is a source-level guard, in the same
+// spirit as TestFirecrackerConfigsDisableSignalForwarding: an fc.Config may only
+// obtain its Smt value from the m.fcSmt helper. A hand-written `Smt:
+// fcBool(...)` at a boot site would bypass both the enablement flag and the
+// even-vCPU rule — and on a stock-FC arm64 runner that fails every boot.
+func TestFirecrackerConfigsUseFcSmtHelper(t *testing.T) {
+	files, err := filepath.Glob("*.go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, f := range files {
+		if strings.HasSuffix(f, "_test.go") {
+			continue
+		}
+		src, err := os.ReadFile(f)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, line := range strings.Split(string(src), "\n") {
+			body := stripLineComments(line)
+			if !strings.Contains(body, "Smt:") {
+				continue
+			}
+			if !strings.Contains(body, "fcSmt(") {
+				t.Errorf("%s:%d: `Smt:` must be set from m.fcSmt(vcpus), got %q — a literal "+
+					"value bypasses the RLP_FC_SMT gate and the even-vCPU rule, and an "+
+					"explicit smt=false is rejected outright by upstream FC on aarch64",
+					f, i+1, strings.TrimSpace(line))
+			}
+		}
+	}
+}
