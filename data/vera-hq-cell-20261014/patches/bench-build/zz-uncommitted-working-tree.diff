+// pinGuestNeigh installs a PERMANENT neighbour entry for the guest's frozen
+// inner identity (innerGuestIP -> macFromIP(innerGuestIP)) on the inner tap, so
+// the resume hot path never resolves ARP.
+//
+// Why (issue #3265): a recycled pool slot keeps a FAILED neighbour entry for the
+// guest (measured: 53 of 60 slots on an idle runner), so the runner's first
+// probe SYN triggers a fresh resolution. That ARP request is queued to the tap
+// during the snapshot-restore window, the guest never raises an RX interrupt for
+// it, and the kernel does not retry for retrans_time_ms (1s). The guest's own
+// announcement cannot rescue it on arm64 either: the daemon's resume detector
+// keys on a monotonic-clock jump that a restored guest does not have
+// (uptime resumes at the snapshot instant), so only its 1s keepalive does -- and
+// that ticker's phase is frozen in the template, which is why the stall is a
+// FIXED ~580ms on ~25% of clones.
+//
+// Both the IP and the MAC are compile-time constants of the frozen inner
+// identity (every clone of every template boots with them), so one permanent
+// entry per slot is correct for every tenant the slot will ever hold -- the same
+// reasoning that lets pinTapMAC fix the MAC in the other direction.
+//
+// Gated RLP_NEIGH_PERMANENT=1 while it is being measured; the entry is removed
+// with the netns.
+func pinGuestNeigh(tap netlink.Link) error {
+	if os.Getenv("RLP_NEIGH_PERMANENT") != "1" {
+		return nil
+	}
+	hw, err := net.ParseMAC(macFromIP(innerGuestIP))
+	if err != nil {
+		return err
+	}
+	return netlink.NeighSet(&netlink.Neigh{
+		LinkIndex:    tap.Attrs().Index,
+		Family:       netlink.FAMILY_V4,
+		State:        netlink.NUD_PERMANENT,
+		IP:           net.ParseIP(innerGuestIP),
+		HardwareAddr: hw,
+	})
+}
+
