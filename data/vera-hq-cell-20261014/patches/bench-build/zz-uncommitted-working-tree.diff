+// ---- pre-created cgroup pool (issue #3261) ----
+//
+// Creating a cgroup is serialized by the kernel and is NOT cheap at this host
+// size: 1000 mkdirs in one parent with the cpu+memory+pids controllers cost
+// ~0.86s wall even 256-way parallel on a 352-CPU host (~0.47s with cpu alone —
+// the per-CPU memcg state is the price). That lands in every clone's critical
+// path, where it was measured at p50 157ms / p90 417ms during a 1k burst, and
+// at p50 498ms once the init-disk I/O (#3260) stopped hiding it.
+//
+// The netns pool already solves this shape of problem for network namespaces:
+// make the expensive object ahead of time, off the hot path. Pool entries are
+// single use — a clone takes one, teardown rmdir's it exactly as before, and
+// the fillers keep the pool topped up.
+//
+// Gated RLP_CGROUP_POOL=<size> (0 = off, the historical inline mkdir). While it
+// is on a per-VM cgroup's name no longer encodes the VM id, so startup adoption
+// of a VM that outlived a runner restart cannot find its cgroup and usage falls
+// back to /proc (cgroupDirFor / adopt.go). That is why it is not on by default.
+var (
+	cgPoolCh   chan string
+	cgPoolOnce sync.Once
+	cgPoolSeq  atomic.Uint64
+)
+
+func cgPoolStart() {
+	n := envInt("RLP_CGROUP_POOL", 0)
+	root := cgroupBase()
+	if n <= 0 || root == "" {
+		return
+	}
+	cgPoolCh = make(chan string, n)
+	slog.Warn("cgroup pool enabled: per-VM cgroups are pool-named, so adoption after a runner restart will not find them",
+		"size", n, "fillers", envInt("RLP_CGROUP_POOL_FILLERS", 8))
+	for i := 0; i < envInt("RLP_CGROUP_POOL_FILLERS", 8); i++ {
+		go func() {
+			for {
+				dir := filepath.Join(root, fmt.Sprintf("vm-pool-%d-%d", os.Getpid(), cgPoolSeq.Add(1)))
+				if err := os.Mkdir(dir, 0o755); err != nil && !os.IsExist(err) {
+					slog.Warn("cgroup pool mkdir failed", "dir", dir, "err", err)
+					time.Sleep(500 * time.Millisecond)
+					continue
+				}
+				cgPoolCh <- dir // blocks while the pool is full
+			}
+		}()
+	}
+}
+
+// cgPoolGet returns a pre-created cgroup dir, or "" when the pool is off or
+// momentarily empty (the caller then does the inline mkdir, as before).
+func cgPoolGet() string {
+	cgPoolOnce.Do(cgPoolStart)
+	if cgPoolCh == nil {
+		return ""
+	}
+	select {
+	case d := <-cgPoolCh:
+		return d
+	default:
+		return ""
+	}
+}
+
