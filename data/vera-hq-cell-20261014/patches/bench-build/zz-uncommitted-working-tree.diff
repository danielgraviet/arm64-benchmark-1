@@ -1567,6 +1567,42 @@ func (m *Manager) Clone(ctx context.Context, vmID, sandboxID string, tpl *Templa
 
 // sparseCopy copies src->dst preserving holes (cp --sparse=always style). The
 // golden scratch is mostly empty ext4, so this is fast and space-cheap.
+// provisionInitdisk creates the clone's PRIVATE vda target. Mode is
+// RLP_INITDISK_MODE (issue #3260):
+//
+//	copy    (default) io.Copy + fsync -- the historical behavior.
+//	nofsync io.Copy, no fsync. The file is per-clone scratch removed at teardown,
+//	        so durability buys nothing, and the fsync is what serializes a burst
+//	        (measured: 64ms-1s per call, 1000 per 1k burst, NVMe pinned at 97%).
+//	sparse  no data written at all: ftruncate to the master's size. Valid only
+//	        because the resumed guest has already pivoted off vda and never reads
+//	        it (see the caller's comment) -- FC just reopens a writable file of
+//	        the right size at restore.
+func provisionInitdisk(src, dst string) error {
+	switch getenv("RLP_INITDISK_MODE", "copy") {
+	case "nofsync":
+		return copyFileContentsNoSync(src, dst)
+	case "sparse":
+		fi, err := os.Stat(src)
+		if err != nil {
+			return err
+		}
+		_ = os.Remove(dst)
+		f, err := os.OpenFile(dst, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o644)
+		if err != nil {
+			return err
+		}
+		if err := f.Truncate(fi.Size()); err != nil {
+			f.Close()
+			_ = os.Remove(dst)
+			return err
+		}
+		return f.Close()
+	default:
+		return copyFileContents(src, dst)
+	}
+}
