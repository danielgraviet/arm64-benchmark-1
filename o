#!/usr/bin/env bash
# Ultra-short typed entry on OCI Vera. After git pull:
#   ./o g
#
# Letters: g=go  l=load  c=check  s=smoke  1=c1k  2=c2k  d=dense  t=status  h=help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
cmd="${1:-h}"
shift || true
case "${cmd}" in
  g|go|boot)
    # Resume after a mid-bootstrap failure: skip the long Rust rebuild if bins exist.
    if [[ -x /usr/local/bin/rlp-api && -z "${SKIP_BUILD:-}" ]]; then
      export SKIP_BUILD=1
      echo "SKIP_BUILD=1 (rlp-api already installed)"
    fi
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  l|load)    exec bash "${ROOT}/scripts/host/oci" load "$@" ;;
  c|check)   exec bash "${ROOT}/scripts/host/oci" check "$@" ;;
  s|smoke)
    # 401 here is the key in .env, not the runner. Remint once before the long smoke.
    if [[ -f "${ROOT}/.env" ]]; then
      set -a
      # shellcheck disable=SC1091
      source "${ROOT}/.env"
      set +a
    fi
    key_code="$(curl -sS -m 5 -o /dev/null -w '%{http_code}' \
      -H "Authorization: Bearer ${VERA_RLP_API_KEY:-}" \
      http://127.0.0.1:8088/vms || echo 000)"
    echo "api key probe: HTTP ${key_code} (key length ${#VERA_RLP_API_KEY})"
    if [[ "${key_code}" != "200" ]]; then
      echo "key probe HTTP ${key_code}. reminting."
      bash "${ROOT}/scripts/host/oci_remint.sh"
      set -a
      # shellcheck disable=SC1091
      source "${ROOT}/.env"
      set +a
      key_code="$(curl -sS -m 5 -o /tmp/oci-key-probe.txt -w '%{http_code}' \
        -H "Authorization: Bearer ${VERA_RLP_API_KEY:-}" \
        http://127.0.0.1:8088/vms || echo 000)"
      echo "api key probe after mint: HTTP ${key_code} (key length ${#VERA_RLP_API_KEY})"
      if [[ "${key_code}" != "200" ]]; then
        echo "key still rejected. body:" >&2
        cat /tmp/oci-key-probe.txt >&2 || true
        exit 1
      fi
    fi
    # Drop any parent-shell key so smoke reads .env via load_dotenv(override=True).
    unset VERA_RLP_API_KEY RLP_API_KEY || true
    # Create uses the API. process.exec uses the toolbox proxy, which
    # authorizes the same key through its own RLP_DB_URL. A stale URL 401s
    # exec after create already returned a sandbox id.
    db_url="$(sudo -n grep -E '^DATABASE_URL=' /etc/rlp/api.env | tail -n1 | cut -d= -f2- || true)"
    if [[ -n "${db_url}" ]]; then
      if sudo -n grep -q '^RLP_DB_URL=' /etc/rlp/proxy.env 2>/dev/null; then
        sudo -n sed -i "s|^RLP_DB_URL=.*|RLP_DB_URL=${db_url}|" /etc/rlp/proxy.env
      else
        echo "RLP_DB_URL=${db_url}" | sudo -n tee -a /etc/rlp/proxy.env >/dev/null
      fi
      sudo -n systemctl restart rlp-proxy
      echo "restarted rlp-proxy with the API database URL"
    fi
    bash "${ROOT}/scripts/host/oci_seed_cpu.sh"
    bash "${ROOT}/scripts/host/oci_why.sh"
    follow="/tmp/oci-smoke-runner.log"
    : > "${follow}"
    # sudo only on journalctl. The shell owns the file, so we can read it after.
    sudo -n journalctl -u rlp-runner -f --since now -o cat \
      | grep -v 'netns pool gauge' >> "${follow}" &
    follow_pid=$!
    set +e
    bash "${ROOT}/scripts/host/oci" smoke "$@"
    smoke_rc=$?
    set -e
    sudo -n kill "${follow_pid}" 2>/dev/null || kill "${follow_pid}" 2>/dev/null || true
    wait "${follow_pid}" 2>/dev/null || true
    echo "=== runner log during smoke (gauges hidden) ==="
    tail -n 40 "${follow}" 2>/dev/null || true
    if [[ "${smoke_rc}" -ne 0 ]]; then
      echo "=== smoke failed (exit ${smoke_rc}) ==="
      echo "=== proxy log ==="
      sudo -n journalctl -u rlp-proxy --no-pager -n 30 2>/dev/null \
        | grep -Ei 'toolbox auth denied|db connect|unauthorized|error' | tail -n 15 || true
      bash "${ROOT}/scripts/host/oci_why.sh"
      exit "${smoke_rc}"
    fi
    ;;
  m|mint)
    exec bash "${ROOT}/scripts/host/oci_remint.sh" "$@"
    ;;
  1|c1k)     exec bash "${ROOT}/scripts/host/oci" c1k "$@" ;;
  2|c2k)     exec bash "${ROOT}/scripts/host/oci" c2k "$@" ;;
  d|dense)   exec bash "${ROOT}/scripts/host/oci" dense "$@" ;;
  t|status)  exec bash "${ROOT}/scripts/host/oci" status "$@" ;;
  x|disk)
    exec bash "${ROOT}/scripts/host/oci_free_disk.sh" "$@"
    ;;
  p|pull)
    git pull --ff-only
    if [[ -x /usr/local/bin/rlp-api && -z "${SKIP_BUILD:-}" ]]; then
      export SKIP_BUILD=1
    fi
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  r|reset)
    echo "removing ${HOME}/rlp"
    rm -rf "${HOME}/rlp"
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  k|kernel|guest)
    exec bash "${ROOT}/scripts/host/oci_build_guest.sh" "$@"
    ;;
  a|daemon)
    exec bash "${ROOT}/scripts/host/oci_build_daemon.sh" "$@"
    ;;
  w|why)
    exec bash "${ROOT}/scripts/host/oci_why.sh" "$@"
    ;;
  j|journal|log)
    sudo systemctl status rlp-api --no-pager -l 2>&1 | head -n 30 || true
    echo '---'
    sudo journalctl -u rlp-api -n 50 --no-pager 2>&1 || true
    ;;
  z|zapdb)
    # Wipe postgres/nats volumes so a fresh password in /opt/rlp/deploy/.env works.
    echo "wiping rlp postgres/nats docker volumes"
    sudo docker rm -f rlp-postgres rlp-nats 2>/dev/null || true
    (cd /opt/rlp/deploy && sudo docker compose down -v) 2>/dev/null || true
    rm -f /opt/rlp/deploy/.env
    echo "done. Next: ./o g"
    ;;
  h|help|-h|--help)
    cat <<'EOF'
./o g     boot / resume (uses .env.oci; sudo docker if needed)
./o k     build guest Image + initdisk into /var/lib/rlp/kernel/
./o a     build arm64 daemon system layer (toolbox :2280)
./o j     show rlp-api journal (when health fails)
./o z     wipe postgres/nats volumes (password mismatch fix)
./o p     git pull then boot
./o r     delete ~/rlp then boot
./o l     decrypt secrets → .env.oci
./o c     parity check
./o m     remint API key (fixes smoke 401)
./o w     why creates are not picked up
./o s     smoke (prints why first)
./o 1     create-ready 1000
./o 2     create-ready 2000
./o d     dense2k
./o t     status
./o x     show disk use and delete kernel source
EOF
    ;;
  *)
    echo "unknown: ${cmd}  (./o h)" >&2
    exit 2
    ;;
esac
