#!/usr/bin/env bash
# Ultra-short typed entry on OCI Vera. After git pull:
#   ./o g
#
# Letters: g=go  l=load  c=check  s=smoke  1=c1k  2=c2k  d=dense  t=status  h=help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
cmd="${1:-h}"
shift || true
case "${cmd}" in
  g|go|boot)
    # Resume after a mid-bootstrap failure: skip the long Rust rebuild if bins exist.
    if [[ -x /usr/local/bin/rlp-api && -z "${SKIP_BUILD:-}" ]]; then
      export SKIP_BUILD=1
      echo "SKIP_BUILD=1 (rlp-api already installed)"
    fi
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  l|load)    exec bash "${ROOT}/scripts/host/oci" load "$@" ;;
  c|check)   exec bash "${ROOT}/scripts/host/oci" check "$@" ;;
  s|smoke)
    bash "${ROOT}/scripts/host/oci_seed_cpu.sh"
    exec bash "${ROOT}/scripts/host/oci" smoke "$@"
    ;;
  m|mint)
    exec bash "${ROOT}/scripts/host/oci_remint.sh" "$@"
    ;;
  1|c1k)     exec bash "${ROOT}/scripts/host/oci" c1k "$@" ;;
  2|c2k)     exec bash "${ROOT}/scripts/host/oci" c2k "$@" ;;
  d|dense)   exec bash "${ROOT}/scripts/host/oci" dense "$@" ;;
  t|status)  exec bash "${ROOT}/scripts/host/oci" status "$@" ;;
  p|pull)
    git pull --ff-only
    if [[ -x /usr/local/bin/rlp-api && -z "${SKIP_BUILD:-}" ]]; then
      export SKIP_BUILD=1
    fi
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  r|reset)
    echo "removing ${HOME}/rlp"
    rm -rf "${HOME}/rlp"
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  k|kernel|guest)
    exec bash "${ROOT}/scripts/host/oci_build_guest.sh" "$@"
    ;;
  j|journal|log)
    sudo systemctl status rlp-api --no-pager -l 2>&1 | head -n 30 || true
    echo '---'
    sudo journalctl -u rlp-api -n 50 --no-pager 2>&1 || true
    ;;
  z|zapdb)
    # Wipe postgres/nats volumes so a fresh password in /opt/rlp/deploy/.env works.
    echo "wiping rlp postgres/nats docker volumes"
    sudo docker rm -f rlp-postgres rlp-nats 2>/dev/null || true
    (cd /opt/rlp/deploy && sudo docker compose down -v) 2>/dev/null || true
    rm -f /opt/rlp/deploy/.env
    echo "done. Next: ./o g"
    ;;
  h|help|-h|--help)
    cat <<'EOF'
./o g     boot / resume (uses .env.oci; sudo docker if needed)
./o k     build guest Image + initdisk into /var/lib/rlp/kernel/
./o j     show rlp-api journal (when health fails)
./o z     wipe postgres/nats volumes (password mismatch fix)
./o p     git pull then boot
./o r     delete ~/rlp then boot
./o l     decrypt secrets → .env.oci
./o c     parity check
./o m     remint API key (fixes smoke 401)
./o s     smoke
./o 1     create-ready 1000
./o 2     create-ready 2000
./o d     dense2k
./o t     status
EOF
    ;;
  *)
    echo "unknown: ${cmd}  (./o h)" >&2
    exit 2
    ;;
esac
