#!/usr/bin/env bash
# Ultra-short typed entry on OCI Vera. After git pull:
#   ./o g
#
# Letters: g=go  l=load  c=check  s=smoke  1=c1k  2=c2k  d=dense  t=status  h=help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"
cmd="${1:-h}"
shift || true
case "${cmd}" in
  g|go|boot) exec bash "${ROOT}/scripts/host/oci" go "$@" ;;
  l|load)    exec bash "${ROOT}/scripts/host/oci" load "$@" ;;
  c|check)   exec bash "${ROOT}/scripts/host/oci" check "$@" ;;
  s|smoke)   exec bash "${ROOT}/scripts/host/oci" smoke "$@" ;;
  1|c1k)     exec bash "${ROOT}/scripts/host/oci" c1k "$@" ;;
  2|c2k)     exec bash "${ROOT}/scripts/host/oci" c2k "$@" ;;
  d|dense)   exec bash "${ROOT}/scripts/host/oci" dense "$@" ;;
  t|status)  exec bash "${ROOT}/scripts/host/oci" status "$@" ;;
  p|pull)
    git pull --ff-only
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  r|reset)
    # Wipe broken/incomplete ~/rlp from an interrupted clone, then boot.
    echo "removing ${HOME}/rlp"
    rm -rf "${HOME}/rlp"
    exec bash "${ROOT}/scripts/host/oci" go "$@"
    ;;
  h|help|-h|--help)
    cat <<'EOF'
./o g     boot cell (uses .env.oci)
./o p     git pull then boot
./o r     delete ~/rlp then boot (fix bad checkout)
./o l     decrypt secrets → .env.oci
./o c     parity check
./o s     smoke
./o 1     create-ready 1000
./o 2     create-ready 2000
./o d     dense2k
./o t     status
EOF
    ;;
  *)
    echo "unknown: ${cmd}  (./o h)" >&2
    exit 2
    ;;
esac
